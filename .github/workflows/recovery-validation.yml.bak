name: recovery-validation

on:
  push:
    branches:
      - design/idle-rpg-ui-v1

permissions:
  contents: read

jobs:
  build:
    runs-on: ubuntu-latest
    timeout-minutes: 20
    steps:
      - name: Check out source
        uses: actions/checkout@v4
      - name: Set up Java
        uses: actions/setup-java@v4
        with:
          distribution: temurin
          java-version: "17"
      - name: Set up Gradle
        uses: gradle/actions/setup-gradle@v4
      - name: Run recovery regression tests and assemble debug APK
        run: bash ./gradlew testDebugUnitTest assembleDebug --console=plain
      - name: Upload recovery-fix APK
        uses: actions/upload-artifact@v4
        with:
          name: idlerpg-recovery-fix-apk
          path: app/build/outputs/apk/debug/app-debug.apk
          if-no-files-found: error
          retention-days: 14
