name: followup-validation

on:
  push:
    branches:
      - design/idle-rpg-ui-v1
    paths-ignore:
      - "docs/**"
      - "**/*.bak"

permissions:
  contents: read

jobs:
  compile-and-test:
    runs-on: ubuntu-latest
    timeout-minutes: 20
    steps:
      - name: Check out source
        uses: actions/checkout@v4
      - name: Set up Java
        uses: actions/setup-java@v4
        with:
          distribution: temurin
          java-version: "17"
      - name: Set up Gradle
        uses: gradle/actions/setup-gradle@v4
      - name: Run unit tests and assemble debug APK
        run: bash ./gradlew testDebugUnitTest assembleDebug --console=plain
